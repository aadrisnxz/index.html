<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>CyberEuropa Challenge</title>
<style>
body {
    font-family: Arial;
    background-color: #0b3d91;
    color: white;
    text-align: center;
}
.container {
    margin-top: 50px;
}
button {
    padding: 10px;
    margin: 10px;
    border: none;
    cursor: pointer;
}
.correct { background-color: green; }
.wrong { background-color: red; }
</style>
</head>

<body>

<div class="container">
<h1>🇪🇺 CyberEuropa Challenge</h1>
<h2 id="question"></h2>
<div id="answers"></div>
<h3 id="score"></h3>
</div>

<script>
const questions = [
{
    question: "¿Qué es el phishing?",
    answers: ["Un virus", "Un engaño para robar datos", "Un antivirus", "Un tipo de IA"],
    correct: 1
},
{
    question: "¿Qué ley protege datos en Europa?",
    answers: ["GDPR", "FIFA", "NASA", "UEFA"],
    correct: 0
},
{
    question: "¿Qué hace la inteligencia artificial?",
    answers: ["Cocinar", "Imitar inteligencia humana", "Volar", "Nada"],
    correct: 1
}
];

let current = 0;
let score = 0;

function loadQuestion() {
    document.getElementById("question").innerText = questions[current].question;
    const answersDiv = document.getElementById("answers");
    answersDiv.innerHTML = "";

    questions[current].answers.forEach((answer, index) => {
        const btn = document.createElement("button");
        btn.innerText = answer;
        btn.onclick = () => checkAnswer(index);
        answersDiv.appendChild(btn);
    });
}

function checkAnswer(index) {
    if (index === questions[current].correct) {
        score++;
    }
    current++;
    if (current < questions.length) {
        loadQuestion();
    } else {
        document.getElementById("question").innerText = "Juego terminado";
        document.getElementById("answers").innerHTML = "";
        document.getElementById("score").innerText = "Puntuación: " + score;
    }
}

loadQuestion();
</script>

</body>
</html>